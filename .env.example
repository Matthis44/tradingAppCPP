# Copy to .env and fill in. .env is ignored by git.
# C++ connector format; the Python scripts accept a plain host name such as localhost
MYSQL_HOST=tcp://127.0.0.1:3306
MYSQL_USER=sec_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=securities_master

# Alpaca market data API (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
